  - kind: 2
    languageId: sql
    value: "-- our need information(data) in order and order details\r

      -- do groupby and sum the total profit\r

      -- sort by total profit  \r

      SELECT t1.vertical, SUM(t2.profit) AS total_profit\r

      FROM category t1\r

      JOIN order_details t2\r

      ON t1.category_id = t2.category_id\r

      GROUP BY t1.vertical\r

      ORDER BY total_profit DESC"
    outputs:
