    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT t1.order_id, SUM(t2.profit) AS profit\r

      FROM orders t1\r

      JOIN order_details t2\r

      ON t1.order_id = t2.order_id\r

      GROUP BY t1.order_id\r

      HAVING profit > 0\r

      ORDER BY profit DESC"
