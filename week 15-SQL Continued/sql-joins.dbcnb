                sql: "SELECT *\r

                  FROM orders t1\r

                  JOIN order_details t2\r

                  ON t1.order_id = t2.order_id\r

                  JOIN users t3\r

                  ON t1.user_id = t3.user_id"
                refreshable: true
                table: orders
                schema: ""
                editable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- our need information in users and ,order details \r

      -- but we need to first join the orders and orders-details\r

      -- apply the grouby on state and sum agg opration on profit\r

      -- sort based on profit "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT t3.state, SUM(t2.profit) as total_profit\r

      FROM orders t1\r

      JOIN order_details t2\r

      ON t1.order_id = t2.order_id\r

      JOIN users t3\r

      ON t1.user_id = t3.user_id\r

      GROUP BY t3.state\r

      ORDER BY total_profit DESC"
    outputs:
      - grid:
