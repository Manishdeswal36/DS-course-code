                rowsAffected: 330
                columns:
                  - name: order_id
                    baseType: string
                    definition:
                      id: -1
                      type: column
                      name: order_id
                      dataType: text
                      primaryKey: 0
                      nullable: 1
                      computed: 0
                      identity: 0
                      computedExpression: ""
                      length: "65535"
                      scale: null
                      default: null
                      comment: ""
                      values: null
                      ddl: text
                      ddlWithNull: text, null
                      baseType: string
                  - name: profit
                    baseType: number
                sql: "SELECT t1.order_id, SUM(t2.profit) AS profit\r

                  FROM orders t1\r

                  JOIN order_details t2\r

                  ON t1.order_id = t2.order_id\r

                  GROUP BY t1.order_id\r

                  HAVING profit > 0\r

                  ORDER BY profit DESC"
                refreshable: true
                table: orders
                schema: ""
                editable: true
          isTransposed: false
        height: 320
