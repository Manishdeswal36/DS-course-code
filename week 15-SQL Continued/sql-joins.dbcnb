    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- apply the join\r

      -- group by customer name and apply the count on order\r

      SELECT t1.name, COUNT(t2.order_id) as count\r

      FROM users t1\r

      JOIN orders t2\r

      ON t1.user_id = t2.user_id\r

      GROUP BY t1.name\r

      ORDER BY count DESC"
