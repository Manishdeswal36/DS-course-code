                  - name: name
                    baseType: string
                sql: "SELECT t1.order_id, t1.amount,t1.profit,t3.name\r

                  FROM flipkart.order_details t1\r

                  JOIN flipkart.orders t2\r

                  ON t1.order_id = t2.order_id\r

                  JOIN flipkart.users t3\r

                  ON t2.user_id = t3.user_id"
                refreshable: true
                table: order_details
                schema: flipkart
                editable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "Q: find order_id,name and city by joining user and orders"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT t2.order_id, t1.name,t1.city\r

      FROM flipkart.users t1\r

      JOIN flipkart.orders t2\r

      ON t1.user_id = t2.user_id"
