  - kind: 1
    languageId: markdown
    value: "## Q3: which is the most profitcal category(vertical)"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- data in order and order details\r

      -- do groupby and sum the total profit \r

      SELECT *\r

      FROM category t1\r

      JOIN order_details t2\r

      ON t1.category_id = t2.category_id"
