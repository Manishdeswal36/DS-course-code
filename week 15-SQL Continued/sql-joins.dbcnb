                      baseType: string
                  - name: count
                    baseType: number
                sql: "SELECT t1.name, COUNT(t2.order_id) as count\r

                  FROM users t1\r

                  JOIN orders t2\r

                  ON t1.user_id = t2.user_id\r

                  GROUP BY t1.name\r

                  ORDER BY count DESC"
                refreshable: true
                table: users
                schema: ""
                editable: true
          isTransposed: false
        height: 320
