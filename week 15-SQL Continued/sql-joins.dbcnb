                rowsAffected: 19
                columns:
                  - name: state
                    baseType: string
                  - name: total_profit
                    baseType: number
                sql: "SELECT t3.state, SUM(t2.profit) as total_profit\r

                  FROM orders t1\r

                  JOIN order_details t2\r

                  ON t1.order_id = t2.order_id\r

                  JOIN users t3\r

                  ON t1.user_id = t3.user_id\r

                  GROUP BY t3.state\r

                  ORDER BY total_profit DESC"
                refreshable: true
                table: orders
                schema: ""
                editable: true
          isTransposed: false
        height: 320
