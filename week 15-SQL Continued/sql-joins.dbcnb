                sql: "SELECT * FROM flipkart.order_details t1\r

                  JOIN flipkart.orders t2\r

                  ON t1.order_id = t2.order_id\r

                  JOIN flipkart.users t3\r

                  ON t2.user_id = t3.user_id"
                refreshable: true
                table: order_details
                schema: flipkart
                editable: true
          isTransposed: false
        height: 320
