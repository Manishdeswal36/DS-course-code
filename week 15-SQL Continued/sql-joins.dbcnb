    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- join the orderta details and category \r

      -- group by vertical(categroy) and profit\r

      SELECT t2.vertical, SUM(profit) AS total_profit\r

      FROM order_details t1\r

      JOIN category t2\r

      ON t1.category_id = t2.category_id\r

      GROUP BY t2.vertical\r

      HAVING total_profit > 5000"
