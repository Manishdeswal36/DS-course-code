  - kind: 2
    languageId: sql
    value: "-- our need information in users and ,order details \r

      -- but we need to first join the orders and orders-details \r

      SELECT *\r

      FROM orders t1\r

      JOIN order_details t2\r

      ON t1.order_id = t2.order_id\r

      JOIN users t3\r

      ON t1.user_id = t3.user_id"
