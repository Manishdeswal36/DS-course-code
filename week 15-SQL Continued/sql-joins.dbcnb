  - kind: 2
    languageId: sql
    value: "-- deko agar aap column ka name specifc karo vo bhi kam karega \r

      -- lakin yadi aap ya userid rakta tho errro ata kyuki aap na specify nahi
      kiya\r

      -- kons table ka user id \r

      SELECT order_id, name, city\r

      FROM flipkart.users t1\r

      JOIN flipkart.orders t2\r

      ON t1.user_id = t2.user_id"
