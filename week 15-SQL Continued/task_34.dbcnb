    metadata: {}
  - kind: 1
    languageId: markdown
    value: "\r

      ### `Q-7:` List all customers who have made more than 10 purchases.\r\n"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- join the customers and sales id\r

      -- grobuby customer and count procut id corrspond to them\r

      -- apply the condintion in grouby using having clause then sort them "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT t1.CustomerID,COUNT(ProductID) AS purchase\r

      FROM sales t1\r

      JOIN customers t2\r

      ON t1.CustomerID = t2.CustomerID\r

      GROUP BY t1.CustomerID\r

      HAVING purchase > 10\r

      ORDER BY purchase DESC"
    outputs:
