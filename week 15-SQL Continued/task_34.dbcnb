    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT t1.SalesPersonID ,ROUND (SUM(t1.Quantity * t2.Price)) AS
      revenue\r

      FROM  sales t1\r

      JOIN products t2\r

      ON t1.ProductID = t2.ProductID\r

      JOIN employees t3\r

      ON t1.SalesPersonID = t3.EmployeeID\r

      GROUP BY t1.SalesPersonID\r

      ORDER BY revenue DESC"
