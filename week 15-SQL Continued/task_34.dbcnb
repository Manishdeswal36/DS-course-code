                      ddlWithNull: bigint, null
                      baseType: number
                  - name: purchase
                    baseType: number
                sql: "SELECT t1.CustomerID,COUNT(ProductID) AS purchase\r

                  FROM sales t1\r

                  JOIN customers t2\r

                  ON t1.CustomerID = t2.CustomerID\r

                  GROUP BY t1.CustomerID\r

                  HAVING purchase > 10\r

                  ORDER BY purchase DESC"
                refreshable: true
                table: sales
                editable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "\r

      ### `Q-8` : List all salespeople who have made sales to more than 5
      customers.\r\n"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT SalesPersonID ,COUNT(CustomerID) AS num_count\r

      FROM sales\r

      GROUP BY SalesPersonID"
