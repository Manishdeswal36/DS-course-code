                  - name: CustomerID
                    baseType: number
                    definition:
                      id: -1
                      type: column
                      name: CustomerID
                      dataType: bigint
                      primaryKey: 0
                      nullable: 1
                      computed: 0
                      identity: 0
                      computedExpression: ""
