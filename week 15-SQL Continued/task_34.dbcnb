cells:
  - kind: 1
    languageId: markdown
    value: "## Freedom Ranking for Different Countries\r

      \r

      You can get the dataset from
      [here](https://drive.google.com/drive/folders/1wr0J571rlfexEJ4-de6_tz1QvU\
      -cJ0df?usp=share_link).\r

      \r

      Some feature details of the dataset:\r

      \r

      | Feature | Description |\r

      | :--: | :-- |\r

      | A | Electoral Process |\r

      | B | Political Pluralism and Participation |\r

      | C | Functioning of Government |\r

      | D | Freedom of Expression and Belief |\r

      | E | Associational and Organizational Rights |\r

      | F | Rule of Law |\r

      | G | Personal Autonomy and Individual Rights |\r

      | CL | Civil Liberties Scores |\r

      | Status | F=Free, PF=Partly Free, NF=Not Free |\r

      \r

      \r

      ###`Q-1` Find out top 10 countries' which have maximum A and D values.\r

      \r

      \r

      ###`Q-2` Find out highest CL value for 2020 for every region. Also sort
      the result in descending order. Also display the CL values in descending
      order."
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- question 1\r

      -- straery join a and d then do group by countries and find max\r

      SELECT *\r

      FROM country_ab t1\r

      JOIN country_cd t2\r

      ON t1.Country =t2.Country"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT t1.Country, MAX(A) , MAX(D)\r

      FROM country_ab t1\r

      JOIN country_cd t2\r

      ON t1.Country =t2.Country\r

      GROUP BY t1.Country\r

      ORDER BY MAX(A) DESC\r

      LIMIT 10"
    outputs:
      - grid:
          state:
            version: 34.2.0
            sideBar:
              visible: true
              position: right
              openToolPanel: null
              toolPanels:
                columns:
                  expandedGroupIds: []
            columnSizing:
              columnSizingModel:
                - colId: "0"
                  width: 260.3333333333333
                - colId: "1"
                  width: 146
                - colId: "2"
                  width: 147
            columnOrder:
              orderedColIds:
                - "0"
                - "1"
                - "2"
            rowGroupExpansion:
              expandedRowGroupIds: []
          data:
            duration: 330
            recordsets:
              - rows:
                  - - Ghana
                    - "12"
                    - "14"
                  - - Greece
                    - "12"
                    - "14"
                  - - Grenada
                    - "12"
                    - "15"
                  - - Norway
                    - "12"
                    - "16"
                  - - Andorra
                    - "12"
                    - "16"
                  - - Palau
                    - "12"
                    - "16"
                  - - Antigua and Barbuda
                    - "12"
                    - "15"
                  - - Panama
                    - "12"
                    - "15"
                  - - Poland
                    - "12"
                    - "16"
                  - - Australia
                    - "12"
                    - "16"
                rowsAffected: 10
                columns:
                  - name: Country
                    baseType: string
                    definition:
                      id: -1
                      type: column
                      name: Country
                      dataType: text
                      primaryKey: 0
                      nullable: 1
                      computed: 0
                      identity: 0
                      computedExpression: ""
                      length: "65535"
                      scale: null
                      default: null
                      comment: ""
                      values: null
                      baseType: string
                      ddl: text
                      ddlWithNull: text, null
                  - name: MAX(A)
                    baseType: number
                  - name: MAX(D)
                    baseType: number
                sql: "SELECT t1.Country, MAX(A) , MAX(D)\r

                  FROM country_ab t1\r

                  JOIN country_cd t2\r

                  ON t1.Country =t2.Country\r

                  GROUP BY t1.Country\r

                  ORDER BY MAX(A) DESC\r

                  LIMIT 10"
                refreshable: true
                table: country_ab
                editable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- question  2\r

      SELECT Region, SUM(CL) AS 'cl'\r

      FROM country_ab t1\r

      JOIN country_cl t2\r

      ON t1.Country = t2.Country\r

      WHERE t2.Edition = 2020\r

      GROUP BY Region\r

      ORDER BY cl DESC"
    outputs:
      - grid:
          state:
            version: 34.2.0
            sideBar:
              visible: true
              position: right
              openToolPanel: null
              toolPanels:
                columns:
                  expandedGroupIds: []
            columnSizing:
              columnSizingModel:
                - colId: "0"
                  width: 177
                - colId: "1"
                  width: 109
            columnOrder:
              orderedColIds:
                - "0"
                - "1"
            rowGroupExpansion:
              expandedRowGroupIds: []
          data:
            duration: 20
            recordsets:
              - rows:
                  - - Europe
                    - "22060"
                  - - Americas
                    - "15070"
                  - - Asia
                    - "15030"
                  - - Africa
                    - "14410"
                  - - Eurasia
                    - "3138"
                  - - Middle East
                    - "2500"
                rowsAffected: 6
                columns:
                  - name: Region
                    baseType: string
                    definition:
                      id: -1
                      type: column
                      name: Region
                      dataType: text
                      primaryKey: 0
                      nullable: 1
                      computed: 0
                      identity: 0
                      computedExpression: ""
                      length: "65535"
                      scale: null
                      default: null
                      comment: ""
                      values: null
                      baseType: string
                      ddl: text
                      ddlWithNull: text, null
                  - name: cl
                    baseType: number
                sql: "SELECT Region, SUm(CL) AS 'cl'\r

                  FROM country_ab t1\r

                  JOIN country_cl t2\r

                  ON t1.Country = t2.Country\r

                  WHERE t2.Edition = 2020\r

                  GROUP BY Region\r

                  ORDER BY cl DESC"
                refreshable: true
                table: country_ab
                editable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## Dataset\r

      Data Link->
      https://drive.google.com/drive/folders/1bGgNTDy5L_IodNcGHdB_SNCkUI5MUjmY?\
      usp=share_link\r

      Four Tables:\r

      * Customer\r

      * Employee\r

      * Sales\r

      * Products\r

      \r

      \r

      \r\n"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "### `Q-3` Find top-5 most sold products.\r

      \r\n"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- connect the sales and products\r

      SELECT *\r

      FROM products t1\r

      JOIN sales t2\r

      ON t1.ProductID = t2.ProductID"
