  - kind: 2
    languageId: sql
    value: "-- connect the sales and products\r

      -- grouby product name and sum of quanity sold and sort them \r

      SELECT Name ,SUM(Quantity) AS 'sum'\r

      FROM products t1\r

      JOIN sales t2\r

      ON t1.ProductID = t2.ProductID\r

      GROUP BY Name\r

      ORDER BY sum DESC\r

      LIMIT 5"
    outputs:
      - grid:
          state:
            version: 34.2.0
