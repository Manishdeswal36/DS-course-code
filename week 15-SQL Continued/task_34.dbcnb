    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- join the sales and product table then apply grouby \r

      SELECT SalesPersonID , ROUND(SUM(Price)) AS price\r

      FROM  sales t1\r

      JOIN products t2\r

      ON t1.ProductID = t2.ProductID\r

      GROUP BY SalesPersonID\r

      ORDER BY price DESC"
    outputs:
