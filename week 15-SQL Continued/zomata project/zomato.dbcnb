  - kind: 2
    languageId: sql
    value: "-- join the users and order detials\r

      -- then aplly the groubby and count the number of orders \r

      SELECT t1.name , COUNT(order_id) AS num_of_orders\r

      FROM users t1\r

      JOIN orders t2\r

      ON t1.user_id = t2.user_id\r

      GROUP BY t1.name"
    outputs:
