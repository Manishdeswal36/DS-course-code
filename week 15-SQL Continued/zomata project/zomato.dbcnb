                sql: "SELECT t1.user_id,t1.name, COUNT(t3.order_id) AS num_of_orders\r

                  FROM users t1\r

                  JOIN orders t2\r

                  ON t1.user_id = t2.user_id\r

                  JOIN order_details t3\r

                  ON t2.order_id = t3.order_id\r

                  WHERE t2.user_id = 1 AND date BETWEEN '2022-05-15' AND
                  '2022-09-15'\r

                  GROUP BY t1.user_id,t1.name"
