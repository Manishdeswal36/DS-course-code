    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## 12. show order details of a  particular customer in a given date range"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- you have to join 3 table  because information is scatter\r

      -- first join user and orders by user_id\r

      -- second join  order and order_details by  by order_id\r

      SELECT *\r

      FROM users t1\r

      JOIN orders t2\r

      ON t1.user_id = t2.user_id\r

      JOIN order_details t3\r

      ON t2.order_id = t3.order_id"
