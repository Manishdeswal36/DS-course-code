    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## 13. customer favorite food "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- jis food ko usna sabsa jada baar order kiya hum usko favroite food
      bana ga "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- you have to join 4 times because information is scatter\r

      -- first join user and orders by user_id\r

      -- second join  order and order_details by  by order_id\r

      -- order_details  by food using the food_id\r

      -- then apply the grouby . customer and food\r

      SELECT *\r

      FROM users t1\r

      JOIN orders t2\r

      ON t1.user_id = t2.user_id\r

      JOIN order_details t3\r

      ON t2.order_id = t3.order_id\r

      JOIN food t4\r

      ON t3.f_id = t4.f_id"
