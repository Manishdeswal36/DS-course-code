  - kind: 1
    languageId: markdown
    value: "## 19. find all the veg restuarantss"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT r_name\r

      FROM restaurants t1\r

      JOIN orders t2\r

      ON t1.r_id = t2.r_id\r

      JOIN order_details t3\r

      ON t2.order_id = t3.order_id\r

      JOIN food t4\r

      ON t3.f_id = t4.f_id\r

      GROUP BY r_name\r

      HAVING MIN(`type`) = 'Veg' AND MAX(`type`) = 'Veg'"
    outputs:
