    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT t1.name,t4.f_name, COUNT(*) as count\r

      FROM users t1\r

      JOIN orders t2\r

      ON t1.user_id = t2.user_id\r

      JOIN order_details t3\r

      ON t2.order_id = t3.order_id\r

      JOIN food t4\r

      ON t3.f_id = t4.f_id\r

      GROUP BY t1.name,t4.f_name\r

      ORDER BY count DESC"
