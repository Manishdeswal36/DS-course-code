                rowsAffected: 826
                columns:
                  - name: brand_name
                    baseType: string
                  - name: model
                    baseType: string
                  - name: price
                    baseType: number
                  - name: phone_type
                    baseType: string
                sql: "SELECT brand_name,model,price,\r

                  CASE \r

                  \    WHEN bucket = 1 THEN 'buget'\r

                  \    WHEN bucket = 2 THEN 'mid-range'\r

                  \    WHEN bucket = 3 THEN 'premiums'\r

                  END AS 'phone_type'\r

                  FROM (SELECT\r

                  \    brand_name,\r

                  \    model,\r

                  \    price,\r

                  \    NTILE(3) OVER(ORDER BY price) AS bucket\r

                  \    FROM smartphones\r

                  ) AS t"
                refreshable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT brand_name,model,price,\r

      CASE \r

      \    WHEN bucket = 1 THEN 'buget'\r

      \    WHEN bucket = 2 THEN 'mid-range'\r

      \    WHEN bucket = 3 THEN 'premiums'\r

      END AS 'phone_type'\r

      FROM (SELECT\r

      \    brand_name,\r

      \    model,\r

      \    price,\r

      \    NTILE(3) OVER(PARTITION BY brand_name ORDER BY price) AS bucket\r

      \    FROM smartphones\r

      ) AS t"
    outputs:
      - grid:
          state:
            version: 34.2.0
            sideBar:
              visible: true
