  - kind: 2
    languageId: sql
    value: "-- sol: aap 3 grouby kar do 1. source 2. destination 3. airline ka
      upar\r

      SELECT \r

      \    Source,\r

      \    Destination,\r

      \    Airline,\r

      \    AVG(Price) AS 'avg_fair'\r

      FROM flights\r

      GROUP BY Source,Destination,Airline"
