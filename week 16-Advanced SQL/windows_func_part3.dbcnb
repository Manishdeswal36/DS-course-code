  - kind: 2
    languageId: sql
    value: "-- hamana average nikalana sika ha huma median nikla ha \r

      SELECT *,\r

      PERCENTILE_DISC(0.5) WITHIN GROUP(ORDER BY marks) OVER(PARTITION BY
      branch) AS 'median_marks'\r

      FROM pratice.marks"
    outputs: []
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "Root Cause — MySQL Doesn’t Support PERCENTILE_CONT()\r

      \r

      PERCENTILE_CONT() is a window function available in PostgreSQL, Oracle,
      and SQL Server,\r

      but not in MySQL (even in version 8.x)."
    metadata: {}
  - kind: 1
    languageId: markdown
    value: ""
    metadata: {}
  - kind: 2
    languageId: sql
    value: "WITH ranked AS (\r

      \    SELECT \r

      \        branch,\r

      \        marks,\r

      \        ROW_NUMBER() OVER (PARTITION BY branch ORDER BY marks) AS rn,\r

      \        COUNT(*) OVER (PARTITION BY branch) AS total\r

      \    FROM pratice.marks\r

      )\r

      SELECT \r

      \    branch,\r

      \    AVG(marks) AS median_marks\r

      FROM ranked\r

      WHERE rn IN (FLOOR((total + 1) / 2), CEIL((total + 1) / 2))\r

      GROUP BY branch;\r\n"
    outputs:
      - grid:
          state:
            version: 34.2.0
            sideBar:
              visible: true
              position: right
              openToolPanel: null
              toolPanels:
                columns:
                  expandedGroupIds: []
            columnSizing:
              columnSizingModel:
                - colId: "0"
                  width: 141
                - colId: "1"
                  width: 185
            columnOrder:
              orderedColIds:
                - "0"
                - "1"
            rowGroupExpansion:
              expandedRowGroupIds: []
          data:
            duration: 15
            recordsets:
              - rows:
                  - - CSE
                    - "86.5000"
                  - - ECE
                    - "91.5000"
                  - - EEE
                    - "75.5000"
                  - - MECH
                    - "60.0000"
                rowsAffected: 4
                columns:
                  - name: branch
                    baseType: string
                  - name: median_marks
                    baseType: number
                sql: "WITH ranked AS (\r

                  \    SELECT \r

                  \        branch,\r

                  \        marks,\r

                  \        ROW_NUMBER() OVER (PARTITION BY branch ORDER BY
                  marks) AS rn,\r

                  \        COUNT(*) OVER (PARTITION BY branch) AS total\r

                  \    FROM pratice.marks\r

                  )\r

                  SELECT \r

                  \    branch,\r

                  \    AVG(marks) AS median_marks\r

                  FROM ranked\r

                  WHERE rn IN (FLOOR((total + 1) / 2), CEIL((total + 1) / 2))\r

                  GROUP BY branch;"
                refreshable: true
          isTransposed: false
        height: 320
    metadata: {}
