    languageId: sql
    value: "-- sol: aap 3 grouby kar do 1. source 2. destination 3. airline ka
      upar\r

      -- USE INSIDE THE SUBQUER\r

      SELECT *\r

      FROM (SELECT \r

      \    Source,\r

      \    Destination,\r

      \    Airline,\r

      \    AVG(Price) AS 'avg_fair',\r

      \    DENSE_RANK() OVER(PARTITION BY Source,Destination ORDER BY
      AVG(Price)) AS 'rank'\r

      FROM flights\r

      GROUP BY Source,Destination,Airline\r

      ) AS t\r

      WHERE t.rank < 2\r\n"
