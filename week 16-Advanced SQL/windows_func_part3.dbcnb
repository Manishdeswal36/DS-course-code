                rowsAffected: 826
                columns:
                  - name: brand_name
                    baseType: string
                  - name: model
                    baseType: string
                  - name: price
                    baseType: number
                  - name: NTILE(3) OVER(ORDER BY price)
                    baseType: number
                sql: "SELECT\r

                  \    brand_name,\r

                  \    model,\r

                  \    price,\r

                  \    NTILE(3) OVER(ORDER BY price)\r

                  FROM smartphones"
                refreshable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 1
    languageId: markdown
    value: if else in sql
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT brand_name,model,price,\r

      CASE \r

      \    WHEN bucket = 1 THEN 'buget'\r

      \    WHEN bucket = 2 THEN 'mid-range'\r

      \    WHEN bucket = 3 THEN 'premiums'\r

      END AS 'phone_type'\r

      FROM (SELECT\r

      \    brand_name,\r

      \    model,\r

      \    price,\r

      \    NTILE(3) OVER(ORDER BY price) AS bucket\r

      \    FROM smartphones\r

      ) AS t"
