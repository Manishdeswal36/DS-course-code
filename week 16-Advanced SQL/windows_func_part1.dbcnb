  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    MONTHNAME(date) AS month_name,\r

      \    SUM(amount) AS sum_amount,\r

      \    SUM(amount) - LAG(SUM(amount)) OVER (ORDER BY MONTH(date)) AS
      diff_amount\r

      FROM zomato.orders\r

      GROUP BY MONTH(date), MONTHNAME(date)\r

      ORDER BY MONTH(date);\r\n"
