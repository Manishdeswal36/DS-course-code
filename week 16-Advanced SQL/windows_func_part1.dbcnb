  - kind: 2
    languageId: sql
    value: "SELECT * FROM (\r

      \    SELECT \r

      \    MONTHNAME(date) AS 'month',\r

      \    user_id , \r

      \    SUM(amount) AS 'total',\r

      \    RANK() OVER(PARTITION BY MONTHNAME(date) ORDER BY SUM(amount) DESC )
      AS 'month_rank'\r

      \    FROM orders\r

      \    GROUP BY MONTHNAME(date),user_id \r

      ) t\r

      WHERE t.month_rank < 3\r

      ORDER BY month DESC ,month_rank ASC"
