  - kind: 2
    languageId: sql
    value: "WITH monthly_sales AS (\r

      \    SELECT\r

      \        MONTH(date) AS month_num,\r

      \        MONTHNAME(date) AS month_name,\r

      \        SUM(amount) AS sum_amount\r

      \    FROM zomato.orders\r

      \    GROUP BY MONTH(date), MONTHNAME(date)\r

      )\r

      SELECT\r

      \    month_name,\r

      \    sum_amount,\r

      \    ((sum_amount - LAG(sum_amount) OVER (ORDER BY month_num)) /
      LAG(sum_amount) OVER (ORDER BY month_num)) * 100 \r

      \        AS growth_revenue\r

      FROM monthly_sales\r

      ORDER BY month_num;\r\n"
    outputs:
