                  \    FROM laptops\r

                  ),\r

                  quartiles AS (\r

                  \    SELECT \r

                  \        (SELECT Price FROM ranked WHERE pr >= 0.25 ORDER BY
                  pr LIMIT 1) AS Q1,\r

                  \        (SELECT Price FROM ranked WHERE pr >= 0.75 ORDER BY
                  pr LIMIT 1) AS Q3\r

                  )\r

                  SELECT \r

                  \    l.*,\r

                  \    q.Q1,\r

                  \    q.Q3\r

                  FROM laptops l\r

                  CROSS JOIN quartiles q\r

                  WHERE l.Price < (q.Q1 - 1.5 * (q.Q3 - q.Q1))\r

                  \   OR l.Price > (q.Q3 + 1.5 * (q.Q3 - q.Q1));"
                refreshable: true
          isTransposed: false
        height: 320
