                rowsAffected: 1273
                columns:
                  - name: price
                    baseType: number
                  - name: 0-25K
                    baseType: number
                  - name: 25K-50K
                    baseType: number
                  - name: 50K-75K
                    baseType: number
                  - name: 75K-1L
                    baseType: number
                  - name: 1L-above
                    baseType: number
                sql: "SELECT \r

                  \    price,\r

                  \    CASE WHEN Price BETWEEN 0 AND 25000 THEN 1 ELSE 0 END AS
                  '0-25K',\r

                  \    CASE WHEN Price BETWEEN 25000  AND 50000 THEN 1 ELSE 0
                  END AS '25K-50K',\r

                  \    CASE WHEN Price BETWEEN 50001  AND 75000 THEN 1 ELSE 0
                  END AS '50K-75K',\r

                  \    CASE WHEN Price BETWEEN 75001   AND 100000 THEN 1 ELSE 0
                  END AS '75K-1L',\r

                  \    CASE WHEN Price > 100000 THEN 1 ELSE 0  END
                  AS  '1L-above'\r

                  FROM laptops"
                refreshable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- we create the bucket now do sum of it\r

      -- Create price buckets and count frequency\r

      SELECT\r

      \    SUM(CASE WHEN Price BETWEEN 0 AND 25000 THEN 1 ELSE 0 END) AS
      `0-25K`,\r

      \    SUM(CASE WHEN Price BETWEEN 25001 AND 50000 THEN 1 ELSE 0 END) AS
      `25K-50K`,\r

      \    SUM(CASE WHEN Price BETWEEN 50001 AND 75000 THEN 1 ELSE 0 END) AS
      `50K-75K`,\r

      \    SUM(CASE WHEN Price BETWEEN 75001 AND 100000 THEN 1 ELSE 0 END) AS
      `75K-1L`,\r

      \    SUM(CASE WHEN Price > 100000 THEN 1 ELSE 0 END) AS `1L-above`\r

      FROM laptops;\r

      \r\n"
    outputs:
      - grid:
          state:
            version: 34.2.0
