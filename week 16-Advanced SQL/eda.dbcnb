  - kind: 1
    languageId: markdown
    value: "matlab price column ma koi misiing value nahi ha "
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "### outliers\r

      finding outlier we use the box plot formula "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT * FROM (SELECT *,\r

      PERCENTILE_CONT(0.25) WITHIN GROUP(ORDER BY Price) OVER() AS 'Q1',\r

      PERCENTILE_CONT(0.75) WITHIN GROUP(ORDER BY Price) OVER() AS 'Q3'\r

      FROM laptops) t\r

      WHERE t.Price < t.Q1 - (1.5*(t.Q3 - t.Q1)) OR\r

      t.Price > t.Q3 + (1.5*(t.Q3 - t.Q1));\r\n"
    outputs: []
    metadata: {}
  - kind: 2
    languageId: sql
    value: "WITH ranked AS (\r

      \    SELECT \r

      \        Price,\r

      \        PERCENT_RANK() OVER (ORDER BY Price) AS pr\r

      \    FROM laptops\r

      ),\r

      quartiles AS (\r

      \    SELECT \r

      \        (SELECT Price FROM ranked WHERE pr >= 0.25 ORDER BY pr LIMIT 1)
      AS Q1,\r

      \        (SELECT Price FROM ranked WHERE pr >= 0.75 ORDER BY pr LIMIT 1)
      AS Q3\r

      )\r

      SELECT \r

      \    l.*,\r

      \    q.Q1,\r

      \    q.Q3\r

      FROM laptops l\r

      CROSS JOIN quartiles q\r

      WHERE l.Price < (q.Q1 - 1.5 * (q.Q3 - q.Q1))\r

      \   OR l.Price > (q.Q3 + 1.5 * (q.Q3 - q.Q1));\r\n"
    outputs:
