  - kind: 2
    languageId: sql
    value: "SELECT t.buckets,REPEAT('*',COUNT(*)/5) FROM (SELECT price, \r

      CASE \r

      \tWHEN price BETWEEN 0 AND 25000 THEN '0-25K'\r

      \    WHEN price BETWEEN 25001 AND 50000 THEN '25K-50K'\r

      \    WHEN price BETWEEN 50001 AND 75000 THEN '50K-75K'\r

      \    WHEN price BETWEEN 75001 AND 100000 THEN '75K-100K'\r

      \    ELSE '>100K'\r

      END AS 'buckets'\r

      FROM laptops) t\r

      GROUP BY t.buckets\r

      \r\n"
    outputs:
      - grid:
          state:
            version: 34.2.0
