                rowsAffected: 1273
                columns:
                  - name: Price
                    baseType: number
                  - name: price_bucket
                    baseType: string
                sql: "SELECT \r

                  \    Price,\r

                  \    CASE\r

                  \        WHEN Price BETWEEN 0 AND 25000 THEN '0-25K'\r

                  \        WHEN Price BETWEEN 25001 AND 50000 THEN '25K-50K'\r

                  \        WHEN Price BETWEEN 50001 AND 75000 THEN '50K-75K'\r

                  \        WHEN Price BETWEEN 75001 AND 100000 THEN '75K-1L'\r

                  \        WHEN Price > 100000 THEN '1L-above'\r

                  \    END AS price_bucket\r

                  FROM laptops;"
                refreshable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- in univarite analysis (numerical)\r

      -- make histogram apply the grobuy and count them\r

      SELECT t.price_bucket, count(*)\r

      FROM (SELECT \r

      \    CASE\r

      \        WHEN Price BETWEEN 0 AND 25000 THEN '0-25K'\r

      \        WHEN Price BETWEEN 25001 AND 50000 THEN '25K-50K'\r

      \        WHEN Price BETWEEN 50001 AND 75000 THEN '50K-75K'\r

      \        WHEN Price BETWEEN 75001 AND 100000 THEN '75K-1L'\r

      \        WHEN Price > 100000 THEN '1L-above'\r

      \    END AS price_bucket\r

      FROM laptops) AS t\r

      GROUP BY t.price_bucket\r

      ORDER BY t.price_bucket"
    outputs:
      - grid:
          state:
            version: 34.2.0
            sideBar:
              visible: true
              position: right
              openToolPanel: null
              toolPanels:
                columns:
                  expandedGroupIds: []
            columnSizing:
              columnSizingModel:
                - colId: "0"
                  width: 226
                - colId: "1"
                  width: 148
            columnOrder:
              orderedColIds:
                - "0"
                - "1"
            rowGroupExpansion:
              expandedRowGroupIds: []
          data:
            duration: 6
            recordsets:
              - rows:
                  - - 0-25K
                    - "201"
                  - - 100k (1L-above)
                    - "173"
                  - - 25K-50K
                    - "407"
                  - - 50K-75K
                    - "319"
                  - - 75K-1L
                    - "173"
                rowsAffected: 5
                columns:
                  - name: price_bucket
                    baseType: string
                  - name: count(*)
                    baseType: number
                sql: "SELECT t.price_bucket, count(*)\r

                  FROM (SELECT \r

                  \    CASE\r

                  \        WHEN Price BETWEEN 0 AND 25000 THEN '0-25K'\r

                  \        WHEN Price BETWEEN 25001 AND 50000 THEN '25K-50K'\r

                  \        WHEN Price BETWEEN 50001 AND 75000 THEN '50K-75K'\r

                  \        WHEN Price BETWEEN 75001 AND 100000 THEN '75K-1L'\r

                  \        WHEN Price > 100000 THEN '100k (1L-above)'\r

                  \    END AS price_bucket\r

                  FROM laptops) AS t\r

                  GROUP BY t.price_bucket\r

                  ORDER BY t.price_bucket"
                refreshable: true
          isTransposed: false
        height: 320
