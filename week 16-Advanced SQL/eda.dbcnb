    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- create bucket in the histogram then make frequency count of it.\r

      SELECT \r

      \    price,\r

      \    CASE WHEN Price BETWEEN 0 AND 25000 THEN 1 ELSE 0 END AS '0-25K',\r

      \    CASE WHEN Price BETWEEN 25000  AND 50000 THEN 1 ELSE 0 END AS
      '25K-50K',\r

      \    CASE WHEN Price BETWEEN 50001  AND 75000 THEN 1 ELSE 0 END AS
      '50K-75K',\r

      \    CASE WHEN Price BETWEEN 75001   AND 100000 THEN 1 ELSE 0 END AS
      '75K-1L',\r

      \    CASE WHEN Price > 100000 THEN 1 ELSE 0  END AS  '1L-above'\r

      FROM laptops"
