    metadata: {}
  - kind: 2
    languageId: sql
    value: "WITH ordered AS (\r

      \    SELECT \r

      \        Price,\r

      \        PERCENT_RANK() OVER (ORDER BY Price) AS pr\r

      \    FROM laptops\r

      )\r

      SELECT \r

      \    COUNT(*) AS total_count,\r

      \    MIN(Price) AS min_price,\r

      \    MAX(Price) AS max_price,\r

      \    AVG(Price) AS avg_price,\r

      \    STD(Price) AS std_dev,\r

      \    (SELECT Price FROM ordered WHERE pr >= 0.25 ORDER BY pr LIMIT 1) AS
      Q1,\r

      \    (SELECT Price FROM ordered WHERE pr >= 0.50 ORDER BY pr LIMIT 1) AS
      Median,\r

      \    (SELECT Price FROM ordered WHERE pr >= 0.75 ORDER BY pr LIMIT 1) AS
      Q3\r

      FROM ordered;\r\n"
    outputs:
      - grid:
          state:
            version: 34.2.0
            sideBar:
              visible: true
