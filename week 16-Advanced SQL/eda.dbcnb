                sql: "SELECT\r

                  \    SUM(CASE WHEN Price BETWEEN 0 AND 25000 THEN 1 ELSE 0
                  END) AS `0-25K`,\r

                  \    SUM(CASE WHEN Price BETWEEN 25001 AND 50000 THEN 1 ELSE 0
                  END) AS `25K-50K`,\r

                  \    SUM(CASE WHEN Price BETWEEN 50001 AND 75000 THEN 1 ELSE 0
                  END) AS `50K-75K`,\r

                  \    SUM(CASE WHEN Price BETWEEN 75001 AND 100000 THEN 1 ELSE
                  0 END) AS `75K-1L`,\r

                  \    SUM(CASE WHEN Price > 100000 THEN 1 ELSE 0 END) AS
                  `1L-above`\r

