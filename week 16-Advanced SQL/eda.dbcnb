  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    Price,\r

      \    CASE\r

      \        WHEN Price BETWEEN 0 AND 25000 THEN '0-25K'\r

      \        WHEN Price BETWEEN 25001 AND 50000 THEN '25K-50K'\r

      \        WHEN Price BETWEEN 50001 AND 75000 THEN '50K-75K'\r

      \        WHEN Price BETWEEN 75001 AND 100000 THEN '75K-1L'\r

      \        WHEN Price > 100000 THEN '1L-above'\r

      \    END AS price_bucket\r

      FROM laptops;\r\n"
