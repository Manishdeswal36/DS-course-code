                  - name: Memory
                    baseType: string
                  - name: REGEXP_SUBSTR(SUBSTRING_INDEX(Memory,'+',1),'[0-9]+')
                    baseType: string
                  - name: "CASE \r

                      \        WHEN Memory LIKE '%+%' THEN
                      REGEXP_SUBSTR(SUBSTRING_INDEX(Memory,'+',-1),'[0-9]+')\r

                      \        ELSE 0 \r

                      \    END\r\n"
                    baseType: string
                sql: "SELECT \r

                  \    Memory,\r

                  \    REGEXP_SUBSTR(SUBSTRING_INDEX(Memory,'+',1),'[0-9]+'),\r

                  \    CASE \r

                  \        WHEN Memory LIKE '%+%' THEN
                  REGEXP_SUBSTR(SUBSTRING_INDEX(Memory,'+',-1),'[0-9]+')\r

                  \        ELSE 0 \r

                  \    END\r

                  FROM laptops;"
