  - kind: 1
    languageId: markdown
    value: "now we use the if else statement in "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT Memory,\r

      CASE\r

      \tWHEN Memory LIKE '%SSD%' AND Memory LIKE '%HDD%' THEN 'Hybrid'\r

      \    WHEN Memory LIKE '%SSD%' THEN 'SSD'\r

      \    WHEN Memory LIKE '%HDD%' THEN 'HDD'\r

      \    WHEN Memory LIKE '%Flash Storage%' THEN 'Flash Storage'\r

      \    WHEN Memory LIKE '%Hybrid%' THEN 'Hybrid'\r

      \    WHEN Memory LIKE '%Flash Storage%' AND Memory LIKE '%HDD%' THEN
      'Hybrid'\r

      \    ELSE NULL\r

      END AS 'memory_type'\r

      FROM laptops;\r\n"
    outputs:
