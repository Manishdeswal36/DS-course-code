                rowsAffected: 1273
                columns:
                  - name: Memory
                    baseType: string
                  - name: memory_type
                    baseType: string
                sql: "SELECT Memory,\r

                  CASE\r

                  \tWHEN Memory LIKE '%SSD%' AND Memory LIKE '%HDD%' THEN
                  'Hybrid'\r

                  \    WHEN Memory LIKE '%SSD%' THEN 'SSD'\r

                  \    WHEN Memory LIKE '%HDD%' THEN 'HDD'\r

                  \    WHEN Memory LIKE '%Flash Storage%' THEN 'Flash Storage'\r

                  \    WHEN Memory LIKE '%Hybrid%' THEN 'Hybrid'\r

                  \    WHEN Memory LIKE '%Flash Storage%' AND Memory LIKE
                  '%HDD%' THEN 'Hybrid'\r

                  \    ELSE NULL\r

                  END AS 'memory_type'\r

                  FROM laptops;"
                refreshable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 2
    languageId: sql
    value: "UPDATE laptops\r

      SET memory_type = CASE\r

      \tWHEN Memory LIKE '%SSD%' AND Memory LIKE '%HDD%' THEN 'Hybrid'\r

      \    WHEN Memory LIKE '%SSD%' THEN 'SSD'\r

      \    WHEN Memory LIKE '%HDD%' THEN 'HDD'\r

      \    WHEN Memory LIKE '%Flash Storage%' THEN 'Flash Storage'\r

      \    WHEN Memory LIKE '%Hybrid%' THEN 'Hybrid'\r

      \    WHEN Memory LIKE '%Flash Storage%' AND Memory LIKE '%HDD%' THEN
      'Hybrid'\r

      \    ELSE NULL\r

      END;\r\n"
