                sql: "UPDATE laptops\r

                  SET memory_type = CASE\r

                  \tWHEN Memory LIKE '%SSD%' AND Memory LIKE '%HDD%' THEN
                  'Hybrid'\r

                  \    WHEN Memory LIKE '%SSD%' THEN 'SSD'\r

                  \    WHEN Memory LIKE '%HDD%' THEN 'HDD'\r

                  \    WHEN Memory LIKE '%Flash Storage%' THEN 'Flash Storage'\r

                  \    WHEN Memory LIKE '%Hybrid%' THEN 'Hybrid'\r

                  \    WHEN Memory LIKE '%Flash Storage%' AND Memory LIKE
                  '%HDD%' THEN 'Hybrid'\r

                  \    ELSE NULL\r

