  - kind: 2
    languageId: sql
    value: "SELECT DISTINCT Ram\r\nFROM laptops"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- now huma ya GB ko hatana ha \r

      SELECT REPLACE(Ram,'GB','')\r

      FROM laptops"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "UPDATE laptops\r

      SET Ram = REPLACE(Ram, 'GB', '');\r\n"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT DISTINCT Ram\r\nFROM laptops"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- now correct the data type OF RAM COLUMN FROM TEXT TO INT\r

      ALTER TABLE laptops \r

      MODIFY COLUMN Ram INTEGER;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT DISTINCT Weight\r

      FROM laptops"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT REPLACE( Weight , 'kg','')\r

      FROM laptops"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- now update it A\r

      UPDATE laptops\r

      SET Weight = REPLACE( Weight , 'kg','')"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT DISTINCT Weight\r

      FROM laptops"
    metadata: {}
  - kind: 2
    languageId: sql
    value: ALTER TABLE laptops MODIFY COLUMN Price INTEGER
    metadata: {}
