  - kind: 2
    languageId: sql
    value: "UPDATE laptops l1\r

      JOIN (\r

      \    SELECT `index`, \r

      \    REPLACE(REPLACE(Cpu,cpu_brand,''),SUBSTRING_INDEX(REPLACE(Cpu,cpu_br\
      and,''),' ',-1),'') AS cpu_name_extracted\r

      \    FROM laptops\r

      ) AS t\r

      ON l1.`index` = t.`index`\r

      SET l1.cpu_name = t.cpu_name_extracted;"
