                columns:
                  - name: OpSys
                    baseType: string
                  - name: os_brand
                    baseType: string
                sql: "SELECT \r

                  \    OpSys,\r

                  CASE \r

                  \    WHEN OpSys LIKE '%mac%' THEN 'macos'\r

                  \    WHEN OpSys LIKE 'windows%' THEN 'windows'\r

                  \    WHEN OpSys LIKE '%linux%' THEN 'linux'\r

                  \    WHEN OpSys = 'No OS' THEN 'N/A'\r

                  \    ELSE 'other'\r

                  \    END AS 'os_brand'\r

                  \r

                  FROM laptops"
                refreshable: true
          isTransposed: false
        height: 320
