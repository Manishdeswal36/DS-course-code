                sql: "SELECT \r

                  \    primary_storage,\r

                  \    CASE WHEN primary_storage <= 2 THEN primary_storage*1024
                  ELSE primary_storage END,\r

                  secondary_storage,\r

                  CASE WHEN secondary_storage <= 2 THEN secondary_storage*1024
                  ELSE secondary_storage END\r

                  \r

