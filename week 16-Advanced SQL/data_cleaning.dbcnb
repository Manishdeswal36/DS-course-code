  - kind: 1
    languageId: markdown
    value: "now deko ya par kahi 1,2 lika hua ha vo terabit tb ha . aor humana pass
      ya ha gb 128 gb like 256 db     \r

      sol: hum 1,2 tb ko gb ma convert kar dega"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: ""
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    primary_storage,\r

      \    CASE WHEN primary_storage <= 2 THEN primary_storage*1024 ELSE
      primary_storage END,\r

      secondary_storage,\r

      CASE WHEN secondary_storage <= 2 THEN secondary_storage*1024 ELSE
      secondary_storage END\r

      \r

      \    \r

      FROM laptops"
