  - kind: 1
    languageId: markdown
    value: "now hum 3 catoegories banaa waha ha\r

      - mac \r

      - windows\r

      - linusx\r

      - no os\r

      - android chrome (others )"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "tho ab hum new column baneya osname bol ka\r

      apka depended on operating system column hamri value ayegai"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "now use the if else statement in sql like python "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    OpSys,\r

      CASE \r

      \    WHEN OpSys LIKE '%mac%' THEN 'macos'\r

      \    WHEN OpSys LIKE 'windows%' THEN 'windows'\r

      \    WHEN OpSys LIKE '%linux%' THEN 'linux'\r

      \    WHEN OpSys = 'No OS' THEN 'N/A'\r

      \    ELSE 'other'\r

      \    END AS 'os_brand'\r

      \r

      FROM laptops"
