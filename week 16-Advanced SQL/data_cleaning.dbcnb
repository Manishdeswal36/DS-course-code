  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    Memory,\r

      \    REGEXP_SUBSTR(SUBSTRING_INDEX(Memory,'+',1),'[0-9]+'),\r

      \    CASE \r

      \        WHEN Memory LIKE '%+%' THEN
      REGEXP_SUBSTR(SUBSTRING_INDEX(Memory,'+',-1),'[0-9]+')\r

      \        ELSE 0 \r

      \    END\r

      FROM laptops;\r\n"
