    metadata: {}
  - kind: 2
    languageId: sql
    value: "UPDATE laptops l1\r

      JOIN (\r

      \    SELECT `index`, \r

      \    CAST(REPLACE(SUBSTRING_INDEX(Cpu,' ',-1),'GHz','') AS  DECIMAL(10,2))
      AS cpu_speed_extracted\r

      \    FROM laptops\r

      ) AS t\r

      ON l1.`index` = t.`index`\r

      SET l1.cpu_speed = t.cpu_speed_extracted;"
    outputs:
      - grid:
          state:
            version: 34.2.0
            sideBar:
              visible: true
              position: right
              openToolPanel: null
              toolPanels:
                columns:
                  expandedGroupIds: []
            columnSizing:
              columnSizingModel:
                - colId: "0"
                  width: 371
            columnOrder:
              orderedColIds:
                - "0"
            rowGroupExpansion:
              expandedRowGroupIds: []
          data:
            duration: 4005
            recordsets:
              - rows:
                  - - Success, 1273 rows affected
                rowsAffected: 1273
                columns: []
                sql: "UPDATE laptops l1\r

                  JOIN (\r

                  \    SELECT `index`, \r

                  \    CAST(REPLACE(SUBSTRING_INDEX(Cpu,' ',-1),'GHz','')
                  AS  DECIMAL(10,2)) AS cpu_speed_extracted\r

                  \    FROM laptops\r

                  ) AS t\r

                  ON l1.`index` = t.`index`\r

                  SET l1.cpu_speed = t.cpu_speed_extracted;"
                refreshable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 2
