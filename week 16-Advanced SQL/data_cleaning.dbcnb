    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- now update it int \r

      UPDATE laptops l1\r

      JOIN (\r

      \    SELECT `index`, REPLACE(Gpu,gpu_brand,'') AS gpu_name_extracted\r

      \    FROM laptops\r

      ) AS t\r

      ON l1.`index` = t.`index`\r

      SET l1.gpu_name = t.gpu_name_extracted;"
    outputs:
      - grid:
          state:
            version: 34.2.0
