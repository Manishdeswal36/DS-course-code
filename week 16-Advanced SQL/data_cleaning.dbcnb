    metadata: {}
  - kind: 2
    languageId: sql
    value: "UPDATE laptops l1\r

      JOIN (\r

      \    SELECT `index`, SUBSTRING_INDEX(Cpu,' ',1) AS cpu_brand_extracted\r

      \    FROM laptops\r

      ) AS t\r

      ON l1.`index` = t.`index`\r

      SET l1.cpu_brand = t.cpu_brand_extracted;"
    outputs:
      - grid:
          state:
            version: 34.2.0
