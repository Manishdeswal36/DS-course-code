                rowsAffected: 1273
                columns:
                  - name: CAST(REPLACE(SUBSTRING_INDEX(Cpu,' ',-1),'GHz','') AS  DECIMAL(10,2))
                    baseType: number
                sql: "SELECT CAST(REPLACE(SUBSTRING_INDEX(Cpu,' ',-1),'GHz','')
                  AS  DECIMAL(10,2))\r

                  FROM laptops"
