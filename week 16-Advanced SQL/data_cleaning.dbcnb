cells:
  - kind: 1
    languageId: markdown
    value: data cleaning ka principles same raheta ha chaha aap koi bhi tool
      ,programming lanuaguage use karo python,sql
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "Data wragning process\r

      - data gathering\r

      - data asssessment\r

      - data cleaning\r\n"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "aab apko ya gather karna ki jarruat nahi ha vo apko ya mil jayega.\r

      data assessment ka two methods ka manual or programmingly(automatic)\r

      data cleaning "
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "# Data Cleaning and Preparation Steps\r

      \r

      1. **Create Backup**  \r

      2. **Check Number of Rows**  \r

      3. **Check Memory Consumption (for reference)**  \r

      4. **Drop Non-Important Columns**  \r

      5. **Drop Null Values**  \r

      6. **Drop Duplicates**  \r

      7. **Clean RAM → Change Column Data Type**  \r

      8. **Clean Weight → Change Column Type**  \r

      9. **Round Price Column and Convert to Integer**  \r

      10. **Modify the Operating System (OpSys) Column**  \r

      11. **Clean GPU Column**  \r

      12. **Clean CPU Column**\r\n"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT * FROM pratice.laptops\r

      LIMIT 15"
    outputs: []
    metadata: {}
  - kind: 2
    languageId: sql
    value: SELECT COUNT(*) FROM laptops
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## create backup \r

      deko aap data ma changes karo ga isliya  apko sabsa pahal data ka backup
      lena chaya .\r\n"
    metadata: {}
  - kind: 2
    languageId: sql
    value: -- CREATE TABLE laptops_backup LIKE laptops
    outputs: []
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT * FROM laptops_backup\r\n"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- now we have the column strucure now insert the values\r

      -- INSERT INTO laptops_backup\r

      -- SELECT * FROM laptops"
    metadata: {}
  - kind: 2
    languageId: sql
    value: SELECT * FROM laptops
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## check num of row and columns"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- find no of rows\r

      SELECT COUNT(*)\r

      FROM laptops"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: tho hamra pass 1303 laptos ka data ha
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## check memory consumption for refrence"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT *\r

      FROM information_schema.TABLES"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT *\r

      FROM information_schema.TABLES\r

      WHERE TABLE_SCHEMA = 'pratice'\r

      AND TABLE_NAME = 'laptops'"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- data lenght apko bata ha \r

      SELECT DATA_LENGTH/1024\r

      FROM information_schema.TABLES\r

      WHERE TABLE_SCHEMA = 'pratice'\r

      AND TABLE_NAME = 'laptops'"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: tho 256 kb of data occupied in ram
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "### Drop Non-Important Column"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "deko ya unnamed wala column useful nahi ha tho hama isko drop karna hoga
      kyuki index bhi same information da raha ha "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "ALTER TABLE laptops\r

      DROP COLUMN `Unnamed: 0`;\r\n"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## drop null values"
    metadata: {}
  - kind: 2
    languageId: sql
    value: -- we will remove the rows jaha par sara rows null h a
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT * FROM laptops\r

      WHERE Company IS NULL \r

      AND TypeName IS NULL \r

      AND Inches IS NULL\r

      AND ScreenResolution IS NULL \r

      AND Cpu IS NULL AND \r

      Ram IS NULL\r

      AND Memory IS NULL \r

      AND Gpu IS NULL \r

      AND OpSys IS NULL \r

      AND WEIGHT IS NULL \r

      AND Price IS NULL\r\n"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "deko tho asi 30 rows ha now using the subquery we delete it "
    metadata: {}
  - kind: 2
    languageId: sql
    value: SELECT * FROM laptops
    metadata: {}
  - kind: 2
    languageId: sql
    value: "DELETE FROM laptops\r

      WHERE `index` IN (SELECT `index` FROM laptops_backup\r

      WHERE Company IS NULL \r

      AND TypeName IS NULL \r

      AND Inches IS NULL\r

      AND ScreenResolution IS NULL \r

      AND Cpu IS NULL AND \r

      Ram IS NULL\r

      AND Memory IS NULL \r

      AND Gpu IS NULL \r

      AND OpSys IS NULL \r

      AND WEIGHT IS NULL \r

      AND Price IS NULL\r

      )"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## drop duplicates"
    metadata: {}
  - kind: 2
    languageId: sql
    value: -- sabsa phala apko pata karna hoga ki duplicate row kitni ha fir unko
      delete karna hoga
    metadata: {}
  - kind: 2
    languageId: sql
    value: SELECT * FROM pratice.duplicate
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    name,\r

      \    gender,\r

      \    age,\r

      \    COUNT(*)\r

      FROM duplicate\r

      GROUP BY name ,gender,age"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- now we have the dupliates \r

      SELECT \r

      \    name,\r

      \    gender,\r

      \    age,\r

      \    COUNT(*)\r

      FROM duplicate\r

      GROUP BY name ,gender,age\r

      HAVING COUNT(*) > 1"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    MIN(id)\r

      FROM duplicate\r

      GROUP BY name ,gender,age\r

      HAVING COUNT(*) > 1"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- we delete it \r

      -- using windows func or subquery "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- DELETE FROM zomato.duplicate\r

      -- WHERE id is NOT in (SELECT \r

      --     MIN(id)\r

      -- FROM duplicate\r

      -- GROUP BY name ,gender,age\r

      -- HAVING COUNT(*) > 1)"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## clean the columns"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- hum cateogorical column ko clean karta ha \r

      -- sabsa pahela aap find karo\r

      SELECT \r

      \    DISTINCT Company\r

      FROM laptops"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT DISTINCT TypeName\r

      FROM laptops"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- data type of inches ko text sa integer karo\r\n"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT DISTINCT Inches\r

      FROM laptops"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT *\r

      FROM laptops\r

      WHERE Inches = '?'"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT REPLACE(Inches,'?','')\r

      FROM laptops"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "ALTER TABLE `pratice`.`laptops` \r

      CHANGE COLUMN `Inches` `Inches` INT NULL DEFAULT NULL ;"
