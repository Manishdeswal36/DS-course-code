    metadata: {}
  - kind: 2
    languageId: sql
    value: "UPDATE laptops  l1\r

      SET gpu_brand = (SELECT \r

      \    SUBSTRING_INDEX(Gpu,' ',1)\r

      \    FROM laptops  l2 \r

      \    WHERE l2.index = l1.index);"
    outputs: []
    metadata: {}
  - kind: 2
    languageId: sql
    value: "UPDATE laptops l1\r

      JOIN (\r

      \    SELECT `index`, SUBSTRING_INDEX(Gpu, ' ', 1) AS gpu_brand_extracted\r

      \    FROM laptops\r

      ) AS t\r

      ON l1.`index` = t.`index`\r

      SET l1.gpu_brand = t.gpu_brand_extracted;\r\n"
    outputs:
