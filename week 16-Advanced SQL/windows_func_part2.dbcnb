    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- now muja rank dena ha on  the basis of run\r

      -- apply grouby on teams\r

      SELECT \r

      \    BattingTeam ,\r

      \    batter,\r

      \    SUM(batsman_run),\r

      \    DENSE_RANK() OVER(PARTITION BY BattingTeam ORDER BY SUM(batsman_run)
      DESC) AS 'rank_within_team'\r

      FROM ipl\r

      GROUP BY BattingTeam ,batter"
