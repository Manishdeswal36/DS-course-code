      bikta ha
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    t2.f_id,\r

      \    SUM(t1.amount) AS 'total_amount'\r

      FROM orders t1\r

      JOIN order_details t2 \r

      \    ON t1.order_id = t2.order_id\r

      WHERE t1.r_id = 1\r

      GROUP BY t2.f_id;\r\n"
    outputs:
      - grid:
          state:
            version: 34.2.0
            sideBar:
              visible: true
              position: right
              openToolPanel: null
              toolPanels:
                columns:
                  expandedGroupIds: []
            columnSizing:
              columnSizingModel:
                - colId: "0"
                  width: 121
                - colId: "1"
                  width: 179
            columnOrder:
              orderedColIds:
                - "0"
                - "1"
            rowGroupExpansion:
              expandedRowGroupIds: []
          data:
            duration: 2
            recordsets:
              - rows:
                  - - 1
                    - "3050"
                  - - "3"
                    - "2600"
                  - - "2"
                    - "950"
                rowsAffected: 3
                columns:
                  - name: f_id
                    baseType: number
                  - name: total_amount
                    baseType: number
                sql: "SELECT \r

                  \    t2.f_id,\r

                  \    SUM(t1.amount) AS total_amount\r

                  FROM orders t1\r

                  JOIN order_details t2 \r

                  \    ON t1.order_id = t2.order_id\r

                  WHERE t1.r_id = 1\r

                  GROUP BY t2.f_id;"
                refreshable: true
                table: orders
                editable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    t3.f_name,\r

      \    t.total_amount,\r

      \    (t.total_amount / SUM(t.total_amount) OVER()) * 100 AS
      percentage_share\r

      FROM (\r

      \    SELECT \r

      \        t2.f_id,\r

      \        SUM(t1.amount) AS total_amount\r

      \    FROM orders AS t1\r

      \    JOIN order_details AS t2 \r

      \        ON t1.order_id = t2.order_id\r

      \    WHERE t1.r_id = 1\r

      \    GROUP BY t2.f_id\r

      ) AS t\r

      JOIN food AS t3\r

      \    ON t.f_id = t3.f_id;\r\n"
    outputs:
      - grid:
          state:
            version: 34.2.0
            sideBar:
              visible: true
              position: right
              openToolPanel: null
              toolPanels:
                columns:
                  expandedGroupIds: []
            columnSizing:
              columnSizingModel:
                - colId: "0"
                  width: 226
                - colId: "1"
                  width: 179
                - colId: "2"
                  width: 203
            columnOrder:
              orderedColIds:
                - "0"
                - "1"
                - "2"
            rowGroupExpansion:
              expandedRowGroupIds: []
          data:
            duration: 6
            recordsets:
              - rows:
                  - - Non-veg Pizza
                    - "3050"
                    - "46.2121"
                  - - Veg Pizza
                    - "950"
                    - "14.3939"
                  - - Choco Lava cake
                    - "2600"
                    - "39.3939"
                rowsAffected: 3
                columns:
                  - name: f_name
                    baseType: string
                  - name: total_amount
                    baseType: number
                  - name: percentage_share
                    baseType: number
                sql: "SELECT \r

                  \    t3.f_name,\r

                  \    t.total_amount,\r

                  \    (t.total_amount / SUM(t.total_amount) OVER()) * 100 AS
                  percentage_share\r

                  FROM (\r

                  \    SELECT \r

                  \        t2.f_id,\r

                  \        SUM(t1.amount) AS total_amount\r

                  \    FROM orders AS t1\r

                  \    JOIN order_details AS t2 \r

                  \        ON t1.order_id = t2.order_id\r

                  \    WHERE t1.r_id = 1\r

                  \    GROUP BY t2.f_id\r

                  ) AS t\r

                  JOIN food AS t3\r

                  \    ON t.f_id = t3.f_id;"
                refreshable: true
          isTransposed: false
        height: 320
    metadata: {}
