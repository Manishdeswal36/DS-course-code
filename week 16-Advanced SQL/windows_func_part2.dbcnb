                  - name: SUM(batsman_run)
                    baseType: number
                  - name: rank_within_team
                    baseType: number
                sql: "SELECT \r

                  \    BattingTeam ,\r

                  \    batter,\r

                  \    SUM(batsman_run),\r

                  \    DENSE_RANK() OVER(PARTITION BY BattingTeam ORDER BY
                  SUM(batsman_run) DESC) AS 'rank_within_team'\r

                  FROM ipl\r

                  GROUP BY BattingTeam ,batter"
                refreshable: true
                table: ipl
                editable: true
          isTransposed: false
