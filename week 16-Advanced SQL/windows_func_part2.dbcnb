                rowsAffected: 215
                columns:
                  - name: match_no
                    baseType: string
                  - name: runs_scored
                    baseType: number
                  - name: SUM(SUM(batsman_run)) OVER()
                    baseType: number
                sql: "SELECT \r

                  \    CONCAT ('Match-', CAST(ROW_NUMBER() OVER(ORDER BY ID) AS
                  CHAR)) AS 'match_no',\r

                  \    SUM(batsman_run) AS 'runs_scored',\r

                  \    SUM(SUM(batsman_run)) OVER()\r

                  FROM ipl\r

                  WHERE batter = 'V kohli'\r

                  GROUP BY ID"
                refreshable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- now huma cummulative sum nikala ha\r

      -- sum isliya nahi aya kyuki frame tik set nahi ha situation ka hisab sa\r

      SELECT \r

      \    CONCAT ('Match-', CAST(ROW_NUMBER() OVER(ORDER BY ID) AS CHAR)) AS
      'match_no',\r

      \    SUM(batsman_run) AS 'runs_scored',\r

      \    SUM(SUM(batsman_run)) OVER(ROWS BETWEEN UNBOUNDED PRECEDING AND
      current row ) AS 'carrer_runs'\r

      FROM ipl\r

      WHERE batter = 'V kohli'\r

      GROUP BY ID"
