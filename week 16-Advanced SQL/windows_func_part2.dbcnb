    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- now the name of top5 palyer ab bas usko order karna ha \r

      SELECT * \r

      FROM  (   \r

      \    SELECT \r

      \    BattingTeam ,\r

      \    batter,\r

      \    SUM(batsman_run) AS 'total_runs',\r

      \    DENSE_RANK() OVER(PARTITION BY BattingTeam ORDER BY SUM(batsman_run)
      DESC) AS 'rank_within_team'\r

      \    FROM ipl\r

      \    GROUP BY BattingTeam ,batter\r

      ) AS t\r

      WHERE t.rank_within_team < 6"
