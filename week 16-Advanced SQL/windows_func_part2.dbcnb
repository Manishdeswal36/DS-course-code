                rowsAffected: 215
                columns:
                  - name: match_no
                    baseType: string
                  - name: runs_scored
                    baseType: number
                  - name: carrer_runs
                    baseType: number
                  - name: carrer_average
                    baseType: number
                sql: "SELECT \r

                  \    CONCAT ('Match-', CAST(ROW_NUMBER() OVER(ORDER BY ID) AS
                  CHAR)) AS 'match_no',\r

                  \    SUM(batsman_run) AS 'runs_scored',\r

                  \    SUM(SUM(batsman_run)) OVER(ROWS BETWEEN UNBOUNDED
                  PRECEDING AND current row ) AS 'carrer_runs',\r

                  \    AVG(SUM(batsman_run)) OVER(ROWS BETWEEN UNBOUNDED
                  PRECEDING AND current row ) AS 'carrer_average'\r

                  FROM ipl\r

                  WHERE batter = 'V kohli'\r

                  GROUP BY ID"
                refreshable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- now another short method to write syntax\r

      SELECT \r

      \    CONCAT ('Match-', CAST(ROW_NUMBER() OVER(ORDER BY ID) AS CHAR)) AS
      'match_no',\r

      \    SUM(batsman_run) AS 'runs_scored',\r

      \    SUM(SUM(batsman_run)) w AS 'carrer_runs',\r

      \    AVG(SUM(batsman_run)) w AS 'carrer_average'\r

      FROM ipl\r

      WHERE batter = 'V Kohli'\r

      GROUP BY ID\r

      WINDOW w AS (ROWS BETWEEN UNBOUNDED PRECEDING AND current row )"
    outputs: []
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    CONCAT('Match-', CAST(ROW_NUMBER() OVER (ORDER BY ID) AS CHAR)) AS
      match_no,\r

      \    SUM(batsman_run) AS runs_scored,\r

      \    SUM(SUM(batsman_run)) OVER w AS career_runs,\r

      \    AVG(SUM(batsman_run)) OVER w AS career_average\r

      FROM ipl\r

      WHERE batter = 'V Kohli'\r

      GROUP BY ID\r

      WINDOW w AS (ORDER BY ID ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT
      ROW);\r\n"
