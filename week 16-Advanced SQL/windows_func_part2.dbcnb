  - kind: 1
    languageId: markdown
    value: "# Cumulative Average"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    CONCAT ('Match-', CAST(ROW_NUMBER() OVER(ORDER BY ID) AS CHAR)) AS
      'match_no',\r

      \    SUM(batsman_run) AS 'runs_scored',\r

      \    SUM(SUM(batsman_run)) OVER(ROWS BETWEEN UNBOUNDED PRECEDING AND
      current row ) AS 'carrer_runs',\r

      \    AVG(SUM(batsman_run)) OVER(ROWS BETWEEN UNBOUNDED PRECEDING AND
      current row ) AS 'carrer_average'\r

      FROM ipl\r

      WHERE batter = 'V kohli'\r

      GROUP BY ID"
