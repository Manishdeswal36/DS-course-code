  - kind: 2
    languageId: sql
    value: "-- actually question ha 50th match ka baad uska carrer runs kitna ha\r

      -- use the subquery concept\r

      SELECT * \r

      FROM (\r

      \    SELECT \r

      \    CONCAT ('Match-', CAST(ROW_NUMBER() OVER(ORDER BY ID) AS CHAR)) AS
      'match_no',\r

      \    SUM(batsman_run) AS 'runs_scored',\r

      \    SUM(SUM(batsman_run)) OVER(ROWS BETWEEN UNBOUNDED PRECEDING AND
      current row ) AS 'carrer_runs'\r

      FROM ipl\r

      WHERE batter = 'V kohli'\r

      GROUP BY ID\r

      ) AS t\r

      WHERE match_no = 'Match-50'\r\n"
