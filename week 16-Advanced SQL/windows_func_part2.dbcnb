                  - name: SUM(batsman_run)
                    baseType: number
                sql: "SELECT \r

                  \    BattingTeam ,\r

                  \    batter,\r

                  \    SUM(batsman_run)\r

                  FROM ipl\r

                  GROUP BY BattingTeam ,batter"
                refreshable: true
                table: ipl
