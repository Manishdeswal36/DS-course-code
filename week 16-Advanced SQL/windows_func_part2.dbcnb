                rowsAffected: 215
                columns:
                  - name: match_no
                    baseType: string
                  - name: runs_scored
                    baseType: number
                  - name: career_runs
                    baseType: number
                  - name: career_average
                    baseType: number
                  - name: moving_average
                    baseType: number
                sql: "SELECT \r

                  \    CONCAT('Match-', CAST(ROW_NUMBER() OVER (ORDER BY ID) AS
                  CHAR)) AS match_no,\r

                  \    SUM(batsman_run) AS runs_scored,\r

                  \    SUM(SUM(batsman_run)) OVER w AS career_runs,\r

                  \    AVG(SUM(batsman_run)) OVER w AS career_average,\r

                  \    AVG(SUM(batsman_run)) OVER(ROWS BETWEEN 9 PRECEDING AND
                  CURRENT ROW) AS 'moving_average'\r

                  FROM ipl\r

                  WHERE batter = 'V Kohli'\r

                  GROUP BY ID\r

                  WINDOW w AS (ORDER BY ID ROWS BETWEEN UNBOUNDED PRECEDING AND
                  CURRENT ROW);"
                refreshable: true
          isTransposed: false
        height: 320
