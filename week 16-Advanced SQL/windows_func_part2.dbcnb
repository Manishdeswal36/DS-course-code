                rowsAffected: 90
                columns:
                  - name: BattingTeam
                    baseType: string
                  - name: batter
                    baseType: string
                  - name: total_runs
                    baseType: number
                  - name: rank_within_team
                    baseType: number
                sql: "SELECT * \r

                  FROM  (   \r

                  \    SELECT \r

                  \    BattingTeam ,\r

                  \    batter,\r

                  \    SUM(batsman_run) AS 'total_runs',\r

                  \    DENSE_RANK() OVER(PARTITION BY BattingTeam ORDER BY
                  SUM(batsman_run) DESC) AS 'rank_within_team'\r

                  \    FROM ipl\r

                  \    GROUP BY BattingTeam ,batter\r

                  ) AS t\r

                  WHERE t.rank_within_team < 6\r

                  ORDER BY t.BattingTeam ,t.rank_within_team"
                refreshable: true
          isTransposed: false
        height: 320
