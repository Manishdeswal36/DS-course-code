  - kind: 2
    languageId: sql
    value: "-- top-batsman in each team\r

      -- our answer like \r

      -- ipl_team_name  player_name\r

      -- csk     dhoni\r

      \r

      -- now ranking ka through problem solve karna we use the\r

      -- dense rank concept."
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- apply grouby on teams\r

      SELECT \r

      \    BattingTeam ,\r

      \    batter,\r

      \    SUM(batsman_run)\r

      FROM ipl\r

      GROUP BY BattingTeam ,batter"
