                rowsAffected: 215
                columns:
                  - name: match_no
                    baseType: string
                  - name: runs_scored
                    baseType: number
                  - name: career_runs
                    baseType: number
                  - name: career_average
                    baseType: number
                sql: "SELECT \r

                  \    CONCAT('Match-', CAST(ROW_NUMBER() OVER (ORDER BY ID) AS
                  CHAR)) AS match_no,\r

                  \    SUM(batsman_run) AS runs_scored,\r

                  \    SUM(SUM(batsman_run)) OVER w AS career_runs,\r

                  \    AVG(SUM(batsman_run)) OVER w AS career_average\r

                  FROM ipl\r

                  WHERE batter = 'V Kohli'\r

                  GROUP BY ID\r

                  WINDOW w AS (ORDER BY ID ROWS BETWEEN UNBOUNDED PRECEDING AND
                  CURRENT ROW);"
                refreshable: true
          isTransposed: false
        height: 320
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "# Moving Average\r

      also known as Runing average        \r

      aap ek window period decide karta ho        \r

      Example apko  window period ha = 5 .\r

      first five tho 1 to 5 \r

      next fiver  2 to 6\r

      is tara sa apka windows move karta rehta ha         \r

      runing average depedn on aas paas ki data values par na ki overall data
      values par"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: current trend nikalana ki liya data ka andr sa
    metadata: {}
  - kind: 1
    languageId: markdown
    value: now hum vireat kohli ka 10 mathces ka moving average nikala ga
    metadata: {}
  - kind: 2
    languageId: sql
    value: ""
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    CONCAT('Match-', CAST(ROW_NUMBER() OVER (ORDER BY ID) AS CHAR)) AS
      match_no,\r

      \    SUM(batsman_run) AS runs_scored,\r

      \    SUM(SUM(batsman_run)) OVER w AS career_runs,\r

      \    AVG(SUM(batsman_run)) OVER w AS career_average,\r

      \    AVG(SUM(batsman_run)) OVER(ROWS BETWEEN 9 PRECEDING AND CURRENT ROW)
      AS 'moving_average'\r

      FROM ipl\r

      WHERE batter = 'V Kohli'\r

      GROUP BY ID\r

      WINDOW w AS (ORDER BY ID ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT
      ROW);\r\n"
