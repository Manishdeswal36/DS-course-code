    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT model,\r

      ROUND (SQRT(resolution_width*resolution_width +
      resolution_height*resolution_height)/screen_size) AS 'ppi'\r

      FROM smartphones;"
