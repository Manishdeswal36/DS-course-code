                rowsAffected: 826
                columns:
                  - name: model
                    baseType: string
                  - name: ppi
                    baseType: number
                sql: "SELECT model,\r

                  ROUND (sqrt(resolution_width*resolution_width +
                  resolution_height*resolution_height)/screen_size) AS 'ppi'\r

                  FROM smartphones;"
                refreshable: true
          isTransposed: false
        height: 320
