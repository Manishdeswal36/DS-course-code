    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- divide by screen size\r

      SELECT model,\r

      sqrt(resolution_width*resolution_width +
      resolution_height*resolution_height)/screen_size AS 'ppi'\r

      FROM smartphones;\r\n"
    outputs:
