    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## create mathemtical expresion in query"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "deko hamra paas resolution height ha ,resolution width ha ,screen size
      ha       \r

      hum ppi nikal chata ha pixel per inches         \r

      ya bhut important parameters hota ha ppi jitna jada hoga . phone utana
      bright hota ha"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "ppi formula is "
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "\r\n$ppi = \\frac {d_0}{d_1}$"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "$d_0 = \\sqrt {(w^2 + h^2)}\r

      \ \\newline w = \\text {number of pixles in the horizontal line}\r

      \  \\newline h = \\text {number of pixles in the vertical  line} \r

      \  \\newline d_1 = \\text {is the digonal screen size in inches }  $"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: first column is model ,second is ppi
    metadata: {}
  - kind: 2
    languageId: sql
    value: SELECT model,resolution_width FROM smartphones
