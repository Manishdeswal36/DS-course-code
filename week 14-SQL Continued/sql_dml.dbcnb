cells:
  - kind: 1
    languageId: markdown
    value: "schema ko hi database bolta ha "
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "# Insert"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "In last class we done by gui now we run by query "
    metadata: {}
  - kind: 2
    languageId: sql
    value: -- CREATE DATABASE campusx
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "deko ya par koi bhi table nahi ha we know hierachy know we create the
      table "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "CREATE TABLE users(\r

      \    user_id INTEGER PRIMARY KEY AUTO_INCREMENT,\r

      \    name VARChar(100) NOT NULL,\r

      \    email VARChar(100)  UNIQUE,\r

      \    password VARChar(100) \r

      )"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "chalo apna tables ma values ko add karta ha "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- INSERT INTO datbase_name.table_name (column1,column2)\r

      -- VALUE (value1,value2 )"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "INSERT INTO campusx.users (user_id, name, email, password)\r

      VALUES ( NULL,'manish','manish@gmail.com','1234')"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "Always remember jis order ma aap aap jis order ma aap column name sent
      kar raho ho usi "
    metadata: {}
  - kind: 2
    languageId: sql
    value: ""
    metadata: {}
  - kind: 2
    languageId: sql
    value: "\r

      -- columns ko mena specify nahi kiya ha lakin ya par inseration ko order
      tik raka ha \r

      INSERT INTO campusx.users \r

      VALUE (NULL ,'sumit','sumit@gmail.com','5678' )"
    metadata: {}
  - kind: 2
    languageId: sql
    value: ""
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "deko apko sirf name and email dena ha password nahi dena ha ha "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "INSERT INTO campusx.users(name,email)\r

      VALUES ('deepu','deepu@gmail.com')"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "-- example deko muja columns ka order yadd nahi ha lakin fir bhi\r

      -- fir bhi hum columns ka name dekar usma values ko add kar sakta ha "
    metadata: {}
  - kind: 2
    languageId: sql
    value: "INSERT INTO campusx.users (password,name)\r

      VALUES ('1234','aditya')"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "Insert multiple rows together \r\n"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "INSERT INTO  campusx.users VALUES \r

      \    (NULL,'anand','anand@gmail.com', '1234' ) ,\r

      \    (NULL,'ayush','ayush@gmail.com','12345') ,\r

      \    (NULL ,'piyush','piyush@gmail.com','6789')"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "hamana aaj ka task complete kar liya jo ki kar create (insert) karna
      data ko table ka andr "
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## import data in mysql workbench \r

      hamana smartphone dataset jo ko csv ma ha usko hamna sql ma import kiya .
      \r\n"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "# select"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "aap ham sika ga data ko  retriev karna\r

      data ko read karna use select commands "
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## select all \r

      filter all coluumns -> it retrieve all the columns data "
    metadata: {}
